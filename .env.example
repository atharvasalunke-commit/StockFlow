# Copy this file to .env and fill in your own values. .env is git-ignored.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=stockflow
MYSQL_USER=admin
MYSQL_PASSWORD=change-me
# at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# host port 3307 comes from docker-compose.yml
DB_URL=jdbc:mysql://localhost:3307/stockflow?allowPublicKeyRetrieval=true&useSSL=false
